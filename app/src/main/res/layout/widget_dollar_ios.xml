<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <RelativeLayout
        android:id="@+id/dollar_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_ios"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/dollar_flag"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:contentDescription="USD"
            android:scaleType="fitCenter"
            android:src="@drawable/us_flag_round" />

        <LinearLayout
            android:id="@+id/dollar_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dollar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vazirmatn_regular"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="دلار آمریکا"
                android:textColor="#050505"
                android:textDirection="rtl"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/dollar_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="sans-serif"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="USD"
                android:textColor="#88888D"
                android:textDirection="ltr"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dollar_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.045"
            android:maxLines="1"
            android:text="۱۸۷٬۲۰۰"
            android:textColor="#000000"
            android:textDirection="ltr"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/dollar_delta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/dollar_price"
            android:layout_alignParentStart="true"
            android:layout_marginBottom="3dp"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="↓ ۶۰۰"
            android:textColor="#4F876A"
            android:textDirection="rtl"
            android:textSize="12sp" />
    </RelativeLayout>
</FrameLayout>
