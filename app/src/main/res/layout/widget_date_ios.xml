<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/date_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_ios"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/date_day_of_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="شنبه"
            android:textColor="#050505"
            android:textDirection="rtl"
            android:textSize="15sp" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="3dp"
            android:text="" />

        <TextView
            android:id="@+id/date_day_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:maxLines="1"
            android:text="۲۴"
            android:textColor="#000000"
            android:textDirection="rtl"
            android:textSize="50sp" />

        <TextView
            android:layout_width="1dp"
            android:layout_height="4dp"
            android:text="" />

        <TextView
            android:id="@+id/date_full_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vazirmatn_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="مرداد ۱۴۰۵"
            android:textColor="#050505"
            android:textDirection="rtl"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
